{
  "name": "greffon-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Expression trees for TypeScript — ordinary lambdas become typed, serializable trees you can evaluate, ship, or compile to SQL.",
  "license": "MIT",
  "author": "Fabien Ménager",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p type-tests/tsconfig.json",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:dev": "npm run docs:dev -w @greffon-docs/site",
    "docs:build": "npm run docs:build -w @greffon-docs/site",
    "site:build": "tsc -b && npm run build -w @greffon-playground/app && npm run docs:build",
    "check-graph": "node scripts/check-graph.mjs",
    "check-commit": "node scripts/check-commit.mjs --last",
    "bench": "node bench/transform.bench.mjs",
    "bench:check": "node bench/transform.bench.mjs --check",
    "bench:ci": "node bench/transform.bench.mjs --report",
    "verify": "npm run check-graph && npm run typecheck && npm run lint && npm run format:check && npm run test:types && npm run test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.23.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "sql.js": "1.14.2",
    "tinybench": "6.1.3",
    "tsdown": "^0.9.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
