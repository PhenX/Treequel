{
  "name": "@treequel/capture",
  "version": "0.1.0",
  "description": "Treequel's shared subset validator, free-variable analysis and tree serializer (the one shared brain).",
  "keywords": [
    "estree",
    "expression-tree",
    "treequel",
    "validator"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@treequel/tree": "*"
  },
  "devDependencies": {
    "oxc-parser": "^0.144.0"
  },
  "engines": {
    "node": ">=20"
  }
}
