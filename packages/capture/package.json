{
  "name": "@greffon/capture",
  "version": "0.1.0",
  "description": "Greffon's shared subset validator, free-variable analysis and tree serializer (the one shared brain).",
  "keywords": [
    "estree",
    "expression-tree",
    "greffon",
    "validator"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/capture"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/tree": "*"
  },
  "devDependencies": {
    "oxc-parser": "^0.144.0"
  },
  "engines": {
    "node": ">=20"
  }
}
