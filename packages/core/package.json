{
  "name": "@greffon/core",
  "version": "0.1.0",
  "description": "Greffon runtime core: Expr, visitor/rewriter, partial evaluation, printer, WellKnown registry.",
  "keywords": [
    "code-as-data",
    "expression-tree",
    "greffon",
    "interpreter",
    "partial-evaluation"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/tree": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
