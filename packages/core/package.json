{
  "name": "@greffon/core",
  "version": "0.1.1",
  "description": "Greffon runtime core: Expr, visitor/rewriter, partial evaluation, printer, WellKnown registry.",
  "keywords": [
    "code-as-data",
    "expression-tree",
    "greffon",
    "interpreter",
    "partial-evaluation"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/tree": "^0.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
