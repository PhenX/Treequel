{
  "name": "@greffon/eslint-plugin",
  "version": "0.1.1",
  "description": "ESLint rules enforcing the Greffon expression subset (shares the capture validator).",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "expression-tree",
    "greffon"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/capture": "^0.1.1"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.1"
  },
  "peerDependencies": {
    "eslint": ">=8"
  },
  "engines": {
    "node": ">=20"
  }
}
