{
  "name": "@treequel/fallback",
  "version": "0.1.0",
  "description": "Treequel runtime toString() capture fallback (dev-only, lazy-loaded).",
  "keywords": [
    "treequel",
    "fallback",
    "meriyah"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@treequel/capture": "*",
    "@treequel/core": "*",
    "meriyah": "^6.0.0"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/register.ts --format esm --dts",
    "dev": "tsdown src/index.ts src/register.ts --format esm --dts --watch",
    "test": "vitest run"
  }
}
