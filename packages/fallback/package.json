{
  "name": "@greffon/fallback",
  "version": "0.1.0",
  "description": "Greffon runtime toString() capture fallback (dev-only, lazy-loaded).",
  "keywords": [
    "fallback",
    "greffon",
    "meriyah"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/fallback"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts src/register.ts --format esm --dts",
    "dev": "tsdown src/index.ts src/register.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/capture": "*",
    "@greffon/core": "*",
    "meriyah": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
