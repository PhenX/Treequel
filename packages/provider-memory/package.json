{
  "name": "@greffon/provider-memory",
  "version": "0.1.1",
  "description": "Greffon reference provider — runs queries in memory via compiled lambdas.",
  "keywords": [
    "greffon",
    "in-memory",
    "linq",
    "provider"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/provider-memory"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/core": "^0.1.1",
    "@greffon/query": "^0.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
