{
  "name": "@greffon/provider-postgres",
  "version": "0.1.0",
  "description": "Greffon Postgres provider — compiles expression trees to parameterized Postgres.",
  "keywords": [
    "greffon",
    "linq",
    "postgres",
    "provider",
    "sql"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/sql-core": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
