{
  "name": "@treequel/sql-core",
  "version": "0.1.0",
  "description": "Treequel SQL-translation core — the dialect seam, translator, and provider builder shared by the Postgres and SQLite providers.",
  "keywords": [
    "dialect",
    "linq",
    "provider",
    "sql",
    "treequel"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@treequel/core": "*",
    "@treequel/linq": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
