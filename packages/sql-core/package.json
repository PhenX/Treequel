{
  "name": "@greffon/sql-core",
  "version": "0.1.0",
  "description": "Greffon SQL-translation core — the dialect seam, translator, and provider builder shared by the Postgres and SQLite providers.",
  "keywords": [
    "dialect",
    "greffon",
    "linq",
    "provider",
    "sql"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/sql-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/core": "*",
    "@greffon/query": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
