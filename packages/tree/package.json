{
  "name": "@greffon/tree",
  "version": "0.1.0",
  "description": "The Greffon expression-tree wire format: node types, (de)serialization, JSON schema. Zero dependencies.",
  "keywords": [
    "ast",
    "code-as-data",
    "expression-tree",
    "greffon",
    "serialization"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/tree"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  }
}
