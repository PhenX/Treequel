{
  "name": "@treequel/ts-plugin",
  "version": "0.1.0",
  "description": "TypeScript language-service plugin: in-editor Treequel subset diagnostics (shares the capture validator).",
  "keywords": [
    "treequel",
    "typescript",
    "language-service",
    "tsserver"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@treequel/capture": "*",
    "oxc-parser": "^0.144.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  }
}
