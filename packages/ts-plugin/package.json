{
  "name": "@greffon/ts-plugin",
  "version": "0.1.0",
  "description": "TypeScript language-service plugin: in-editor Greffon subset diagnostics (shares the capture validator).",
  "keywords": [
    "greffon",
    "language-service",
    "tsserver",
    "typescript"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/ts-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/capture": "*",
    "oxc-parser": "^0.144.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "engines": {
    "node": ">=20"
  }
}
