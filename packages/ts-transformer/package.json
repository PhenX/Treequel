{
  "name": "@greffon/ts-transformer",
  "version": "0.1.1",
  "description": "TypeScript-compiler transformer (ts-patch or the compiler API) that reifies Greffon query lambdas into expression trees.",
  "keywords": [
    "greffon",
    "transformer",
    "ts-patch",
    "typescript"
  ],
  "homepage": "https://phenx.github.io/Greffon/",
  "bugs": "https://github.com/PhenX/Greffon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhenX/Greffon.git",
    "directory": "packages/ts-transformer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/transform": "^0.1.1"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "engines": {
    "node": ">=20"
  }
}
