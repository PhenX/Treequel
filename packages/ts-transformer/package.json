{
  "name": "@greffon/ts-transformer",
  "version": "0.1.0",
  "description": "TypeScript-compiler transformer (ts-patch or the compiler API) that reifies Greffon query lambdas into expression trees.",
  "keywords": [
    "transformer",
    "greffon",
    "ts-patch",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@greffon/transform": "*"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "engines": {
    "node": ">=20"
  }
}
